{
"markdown-preview-enhanced.previewTheme": "github-dark.css",
"markdown-preview-enhanced.mathRenderingOption": "KaTeX",
"markdown-preview-enhanced.enableWikiLinkSyntax": true,
"markdown-preview-enhanced.liveUpdate": true,
"markdown-preview-enhanced.scrollSync": true,
"markdown.preview.openSideBySide": true,
"markdown-preview-enhanced.katexConfig": {
  "macros": {
    "\\RR": "\\mathbb{R}",
    "\\vect": ["\\mathbf{#1}", 1],
    "\\set": ["\\left\\{#1\\right\\}", 1]
  }
}


"editor.fontFamily": "JetBrains Mono, Fira Code, Cascadia Code, monospace",
"editor.fontLigatures": true,
"editor.renderWhitespace": "boundary",
"editor.minimap.enabled": false,
"workbench.colorTheme": "Tokyo Night Light",  
"latex-workshop.view.pdf.viewer": "tab",

"latex-workshop.latex.autoBuild.run": "onSave",
"markdown.preview.openMarkdownLinks": "inEditor",

"code-runner.runInTerminal": true,

"plantuml.render": "PlantUMLServer",
"plantuml.server": "https://www.plantuml.com/plantuml",
"plantuml.trace.server": "https://www.plantuml.com/plantuml/svg/",
"plantuml.previewFileType": "svg",
"cSpell.words": [
    "Kidger's",
    "Kidger"
],
"extensions.supportVirtualWorkspaces": {
    "shd101wyy.markdown-preview-enhanced": false
}
}

